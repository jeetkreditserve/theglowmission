# Core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,theglowmission.local,theglowmission.com,www.theglowmission.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,https://theglowmission.com,https://www.theglowmission.com
NEXT_PUBLIC_SITE_URL=https://theglowmission.com
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# Database
POSTGRES_DB=theglowmission
POSTGRES_USER=theglowmission
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://theglowmission:change-me@postgres:5432/theglowmission

# Initial CMS admin
ADMIN_EMAIL=admin@theglowmission.local
ADMIN_PASSWORD=change-me-now

# Email and customer auth
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@theglowmission.com
CUSTOMER_REGISTRATION_ENABLED=true
CUSTOMER_PASSWORD_RESET_URL_TEMPLATE=https://theglowmission.com/reset-password?uid={uid}&token={token}
CUSTOMER_PASSWORD_RESET_EMAIL_SUBJECT=Reset your The Glow Mission password
CUSTOMER_PASSWORD_RESET_EXPOSE_TOKEN=false

# App and web notifications
CUSTOMER_NOTIFICATIONS_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:info@theglowmission.com

# CMS-driven app config
APP_CONFIG_CACHE_SECONDS=300

# First-party appointment scheduling
FIRST_PARTY_SCHEDULING_ENABLED=true
CALENDLY_BOOKING_FALLBACK_ENABLED=true
APPOINTMENT_SLOT_HORIZON_DAYS=60
APPOINTMENT_MIN_LEAD_MINUTES=240
APPOINTMENT_DOWNTIME_MINUTES=15
APPOINTMENT_CUSTOMER_CHANGE_CUTOFF_MINUTES=720
APPOINTMENT_REMINDER_MINUTES=1440,120
APPOINTMENT_SCHEDULER_POLL_SECONDS=300
GLOW_GST_RATE_PERCENT=18

# Required real S3 media storage. Do not use LocalStack for this project.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_MEDIA_LOCATION=media
AWS_SEED_ASSET_LOCATION=seed-assets
AWS_PRESIGNED_URL_EXPIRE_SECONDS=900
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_CUSTOM_DOMAIN=
# Optional real AWS-compatible production endpoint only. Leave blank for AWS S3.
AWS_S3_ENDPOINT_URL=
